{
  "name": "coffeelandfc",
  "version": "1.0.0",
  "private": true,
  "description": "Coffeeland FC - Football Academy App (Vite React frontend + Bun backend)",
  "scripts": {
    "install:all": "bun install --cwd=backend && npm install --prefix frontend",
    "dev:backend": "bun --cwd=backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"bun --cwd=backend run dev\" \"npm --prefix frontend run dev\"",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run preview",
    "preview": "npm --prefix frontend run preview"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}